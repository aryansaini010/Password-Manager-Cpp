#include <winver.h>

// Version information — fills the Details tab in Explorer and removes
// the "unknown publisher / no file info" signal that makes
// SmartScreen / Smart App Control look more suspicious.
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Password Manager"
            VALUE "FileDescription", "Password Manager - Qt Vault Application"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "PasswordManager"
            VALUE "OriginalFilename", "PasswordManager.exe"
            VALUE "ProductName", "Password Manager"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Embed a standard UAC manifest (asInvoker, UTF-8, Win10/11 supported).
// This avoids heuristic flags for missing/unknown execution level.
1 RT_MANIFEST "app.manifest"
